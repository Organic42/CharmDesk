<?xml version="1.0" encoding="utf-8"?>
<!--
  MSIX package manifest for CharmDesk, packaged as a "Desktop Bridge" full-trust Win32 app
  (EntryPoint="Windows.FullTrustApplication") rather than a native UWP/WinUI app - CharmDesk
  stays a plain WPF app, MSIX is only a distribution wrapper around it.

  Identity/Publisher and Identity/Name below are the real values Partner Center assigned when
  the app name was reserved - for a Store submission the *.msixupload doesn't need to be signed
  yourself at all, Partner Center re-signs on certification. build-msix.ps1's self-signed test
  certificate only exists for local sideload testing and must have a Subject matching Publisher
  exactly, or Add-AppxPackage rejects the install.
-->
<Package
    xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
    xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
    xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
    xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
    IgnorableNamespaces="uap uap5 rescap">

  <Identity
    Name="DelusionalWorks.CharmDesk"
    Publisher="CN=DA524898-B8B3-4F9F-8851-8835755138A5"
    Version="1.0.0.0"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>CharmDesk</DisplayName>
    <PublisherDisplayName>Delusional_Works</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Applications>
    <Application Id="CharmDesk" Executable="CharmDesk.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="CharmDesk"
        Description="Collectible pixel-art charms that hang off the edge of your desktop with real physics."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" Square310x310Logo="Assets\Square310x310Logo.png" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" />
      </uap:VisualElements>

      <Extensions>
        <!-- Declares "Start with Windows" the Store-sanctioned way. Starts disabled: the
             Settings toggle calls StartupTask.RequestEnableAsync() to turn it on, and the user
             can always override it from Windows' own Startup Apps page (which then reports back
             as DisabledByUser, a state the app surfaces rather than silently fighting).
             TaskId must match the id StartupManager passes to StartupTask.GetAsync(). -->
        <uap5:Extension Category="windows.startupTask" Executable="CharmDesk.exe" EntryPoint="Windows.FullTrustApplication">
          <uap5:StartupTask TaskId="CharmDeskStartupTask" Enabled="false" DisplayName="CharmDesk" />
        </uap5:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>

</Package>
