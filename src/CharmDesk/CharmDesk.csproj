<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>

    <!-- Two build shapes, selected by -p:PackagedBuild=true:

         PackagedBuild=true  (MSIX / Microsoft Store)
           Targets a Windows SDK TFM to get the WinRT projection for
           Windows.ApplicationModel.StartupTask, the Store-sanctioned "start at login" API.
           Pinned to 17763 to match the manifest's MinVersion so this doesn't quietly raise
           the app's minimum Windows requirement.

         PackagedBuild=false (default: plain exe, dev runs, portable copies)
           Plain net8.0-windows. Unpackaged processes have no package identity, so the
           StartupTask API is unusable there anyway - that path falls back to the HKCU Run
           key. Skipping the SDK TFM keeps Microsoft.Windows.SDK.NET.dll (~23MB, dwarfing
           the ~3MB app) out of the published output. -->
    <PackagedBuild Condition="'$(PackagedBuild)' == ''">false</PackagedBuild>
    <TargetFramework Condition="'$(PackagedBuild)' == 'true'">net8.0-windows10.0.17763.0</TargetFramework>
    <TargetFramework Condition="'$(PackagedBuild)' != 'true'">net8.0-windows</TargetFramework>
    <SupportedOSPlatformVersion Condition="'$(PackagedBuild)' == 'true'">10.0.17763.0</SupportedOSPlatformVersion>
    <DefineConstants Condition="'$(PackagedBuild)' == 'true'">$(DefineConstants);PACKAGED_BUILD</DefineConstants>

    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>CharmDesk</AssemblyName>
    <RootNamespace>CharmDesk</RootNamespace>
    <ApplicationIcon>Resources\tray.ico</ApplicationIcon>

    <!-- Identity metadata: surfaces in the exe's file properties, and should be kept in step
         with Package.appxmanifest's Identity/Version (which uses a 4-part x.y.z.0 form, with
         the revision reserved by the Store). -->
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Product>CharmDesk</Product>
    <Authors>Sarthak Wage</Authors>
    <Company>Organic42</Company>
    <Description>Collectible pixel-art charms that hang off the edge of your desktop with real physics.</Description>
    <Copyright>Copyright © 2026 Sarthak Wage</Copyright>
    <!-- Framework-dependent by default: the app (~5K LOC) doesn't need its own copy of the
         .NET+WPF runtime bundled in. A self-contained single-file publish was ~163MB; this
         drops the published output to a few MB and relies on the .NET 8 Desktop Runtime being
         present (which the Microsoft Store installs automatically as an MSIX dependency once
         this ships there - see the packaging project when that's set up). IL trimming only
         applies to self-contained deployments, so it's intentionally not used here. -->
    <SelfContained>false</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- WPF's text/font engine (typography + script analysis for text layout) depends on
         real culture data; InvariantGlobalization crashes it (MS.Internal.FontCache.MajorLanguages
         throws CultureNotFoundException the first time a TextBlock needs a typography check).
         Not a safe trim option for a WPF app - do not re-enable. -->
    <!-- DPI awareness is declared in app.manifest (WPF's mechanism); this project never calls
         System.Windows.Forms.Application.Run, so the WinForms analyzer's suggestion doesn't apply. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Bundled default charm packages, copied next to the exe as charms/<id>/...

         ExcludeFromSingleFile is essential, not cosmetic: with PublishSingleFile the bundler
         will otherwise embed some of these inside the exe, where the app can't see them - it
         reads charms from AppContext.BaseDirectory\charms on disk. That produced a share build
         that silently shipped a charm with no image. -->
    <Content Include="..\..\charms\**\*.*">
      <Link>charms\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <!-- UI typefaces, embedded so the management windows don't depend on what's installed. -->
    <Resource Include="Fonts\*.ttf" />
  </ItemGroup>

  <ItemGroup>
    <!-- UI chimes, loaded from disk at runtime via System.Media.SoundPlayer (not a WPF pack
         resource - SoundPlayer wants a file path/stream, not a pack URI). -->
    <Content Include="Sounds\*.wav">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
  </ItemGroup>

</Project>
