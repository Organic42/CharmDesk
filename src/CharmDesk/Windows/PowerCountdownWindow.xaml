<Window x:Class="CharmDesk.Windows.PowerCountdownWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CharmDesk"
        Width="380" SizeToContent="Height"
        ResizeMode="NoResize"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PegboardBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="Segoe UI" FontSize="13">
    <!-- Deliberately topmost and in the taskbar: this is the last chance to stop the PC
         shutting down, so it must not be possible to lose it behind another window. -->
    <StackPanel Margin="24,20,24,22">
        <TextBlock x:Name="EyebrowText" Style="{StaticResource Eyebrow}"/>
        <TextBlock x:Name="HeadlineText" Style="{StaticResource H1}" FontSize="22" Margin="0,4,0,14" TextWrapping="Wrap"/>

        <Border Style="{StaticResource CardBorder}" Padding="18,14,18,16">
            <StackPanel>
                <TextBlock x:Name="CountdownText" HorizontalAlignment="Center"
                           FontFamily="{StaticResource FontPixelBold}" FontSize="44"
                           Foreground="{StaticResource AccentBrush}"
                           AutomationProperties.LiveSetting="Polite"/>
                <TextBlock x:Name="DetailText" TextWrapping="Wrap" LineHeight="18" Margin="0,10,0,0"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
            </StackPanel>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="NowButton" Margin="0,0,10,0" Click="NowButton_Click"/>
            <Button x:Name="CancelButton" Content="Cancel" Style="{StaticResource AccentButton}"
                    IsDefault="True" IsCancel="True" Click="CancelButton_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
