<Window x:Class="CharmDesk.Windows.CharmPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Preview" Height="380" Width="340" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="TitleText" Style="{StaticResource H1}" Margin="0,0,0,10"/>
        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="0" ClipToBounds="True">
            <Canvas x:Name="PreviewCanvas" Width="290" Height="270" Background="#10121A">
                <Path x:Name="PreviewString" Stroke="#B8B4AC" StrokeThickness="1.3"/>
                <Ellipse x:Name="PreviewAnchor" Width="8" Height="8" Fill="#C4A044"/>
                <Image x:Name="PreviewImage" Stretch="Fill"
                       RenderOptions.BitmapScalingMode="NearestNeighbor"
                       RenderTransformOrigin="0.5,0.5">
                    <Image.RenderTransform>
                        <RotateTransform x:Name="PreviewSpin" Angle="0"/>
                    </Image.RenderTransform>
                </Image>
            </Canvas>
        </Border>
        <TextBlock Grid.Row="2" Text="Grab and pull the charm to try its physics." Style="{StaticResource Muted}" Margin="0,10,0,0"/>
    </Grid>
</Window>
