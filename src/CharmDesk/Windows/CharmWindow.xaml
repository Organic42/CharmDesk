<Window x:Class="CharmDesk.Windows.CharmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CharmDesk"
        WindowStyle="None"
        Background="{x:Null}"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Topmost="True"
        WindowStartupLocation="Manual">
    <Canvas x:Name="RootCanvas" Background="{x:Null}">
        <Path x:Name="StringPath" Stroke="#B8B4AC" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" IsHitTestVisible="False"/>
        <Ellipse x:Name="AnchorDot" Width="9" Height="9" Fill="#C4A044" Stroke="#8C6E28" StrokeThickness="1"/>
        <Canvas x:Name="CharmVisual" Background="#01000000" RenderTransformOrigin="0.5,0.5">
            <Canvas.RenderTransform>
                <RotateTransform x:Name="SpinTransform" Angle="0"/>
            </Canvas.RenderTransform>
            <Image x:Name="CharmImage"
                   Stretch="Fill"
                   RenderOptions.BitmapScalingMode="NearestNeighbor"
                   RenderOptions.EdgeMode="Aliased"
                   SnapsToDevicePixels="True"/>
            <!-- Viewbox auto-scales its text child to fit whatever box size/position is
                 computed at runtime - robust to any font's actual glyph metrics, unlike a
                 hand-tuned FontSize ratio that has to be re-guessed every time the font changes. -->
            <Viewbox x:Name="ClockTimeBox" Visibility="Collapsed" Stretch="Uniform">
                <TextBlock x:Name="ClockTimeText" FontFamily="{StaticResource FontPixelBold}"/>
            </Viewbox>
            <Viewbox x:Name="ClockDateBox" Visibility="Collapsed" Stretch="Uniform">
                <TextBlock x:Name="ClockDateText" FontFamily="{StaticResource FontPixel}"/>
            </Viewbox>
        </Canvas>
    </Canvas>
</Window>
