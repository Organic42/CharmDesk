<Window x:Class="CharmDesk.Windows.CharmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CharmDesk"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Topmost="True"
        WindowStartupLocation="Manual"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">
    <Canvas x:Name="RootCanvas" Background="Transparent">
        <Path x:Name="StringPath" Stroke="#B8B4AC" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
        <Ellipse x:Name="AnchorDot" Width="9" Height="9" Fill="#C4A044" Stroke="#8C6E28" StrokeThickness="1"/>
        <!-- CharmVisual carries the one position + spin transform for the whole charm; the
             image and any live clock text are siblings inside it so both move and spin together
             as a single rigid object, exactly like a real charm on a string. -->
        <Canvas x:Name="CharmVisual" RenderTransformOrigin="0.5,0.5">
            <Canvas.RenderTransform>
                <RotateTransform x:Name="SpinTransform" Angle="0"/>
            </Canvas.RenderTransform>
            <Image x:Name="CharmImage"
                   Stretch="Fill"
                   RenderOptions.BitmapScalingMode="NearestNeighbor"
                   RenderOptions.EdgeMode="Aliased"
                   SnapsToDevicePixels="True"/>
            <TextBlock x:Name="ClockTimeText" Visibility="Collapsed" TextAlignment="Center"
                       FontFamily="{StaticResource FontMono}" FontWeight="Bold"/>
            <TextBlock x:Name="ClockDateText" Visibility="Collapsed" TextAlignment="Center"
                       FontFamily="{StaticResource FontMonoRegular}"/>
        </Canvas>
    </Canvas>
</Window>
