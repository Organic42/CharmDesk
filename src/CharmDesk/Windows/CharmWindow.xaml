<Window x:Class="CharmDesk.Windows.CharmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CharmDesk"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Topmost="True"
        WindowStartupLocation="Manual"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">
    <Canvas x:Name="RootCanvas" Background="Transparent">
        <Path x:Name="StringPath" Stroke="#B8B4AC" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
        <Ellipse x:Name="AnchorDot" Width="9" Height="9" Fill="#C4A044" Stroke="#8C6E28" StrokeThickness="1"/>
        <!-- CharmVisual carries the one position + spin transform for the whole charm; the
             image and any live clock text are siblings inside it so both move and spin together
             as a single rigid object, exactly like a real charm on a string. -->
        <Canvas x:Name="CharmVisual" RenderTransformOrigin="0.5,0.5">
            <Canvas.RenderTransform>
                <RotateTransform x:Name="SpinTransform" Angle="0"/>
            </Canvas.RenderTransform>
            <!-- BitmapCache is what makes this affordable on weak hardware. AllowsTransparency
                 makes this a layered window, and WPF cannot hardware-accelerate those - the
                 whole window is rasterised on the CPU, 60 times a second. Without a cache that
                 means rescaling the source art (Timekeeper's is 1024x1258) down to ~240px on
                 every single frame, which is what makes the charm flicker on integrated
                 graphics. Cached, the expensive resample happens once and each frame only
                 re-composites the result through the spin transform.

                 Cached on the Image rather than on CharmVisual on purpose: the clock text is a
                 sibling that changes once a second, and caching the shared parent would throw
                 the charm's cache away every tick for no reason. -->
            <Image x:Name="CharmImage"
                   Stretch="Fill"
                   CacheMode="BitmapCache"
                   RenderOptions.BitmapScalingMode="NearestNeighbor"
                   RenderOptions.EdgeMode="Aliased"
                   SnapsToDevicePixels="True"/>
            <!-- Viewbox auto-scales its text child to fit whatever box size/position is
                 computed at runtime - robust to any font's actual glyph metrics, unlike a
                 hand-tuned FontSize ratio that has to be re-guessed every time the font changes. -->
            <Viewbox x:Name="ClockTimeBox" Visibility="Collapsed" Stretch="Uniform">
                <TextBlock x:Name="ClockTimeText" FontFamily="{StaticResource FontPixelBold}"/>
            </Viewbox>
            <Viewbox x:Name="ClockDateBox" Visibility="Collapsed" Stretch="Uniform">
                <TextBlock x:Name="ClockDateText" FontFamily="{StaticResource FontPixel}"/>
            </Viewbox>
        </Canvas>
    </Canvas>
</Window>
