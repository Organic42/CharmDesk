<Window x:Class="CharmDesk.Windows.CharmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CharmDesk"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Topmost="True"
        WindowStartupLocation="Manual"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">
    <Canvas x:Name="RootCanvas" Background="Transparent">
        <Path x:Name="StringPath" Stroke="#B8B4AC" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
        <Ellipse x:Name="AnchorDot" Width="9" Height="9" Fill="#C4A044" Stroke="#8C6E28" StrokeThickness="1"/>
        <Image x:Name="CharmImage"
               Stretch="Fill"
               RenderOptions.BitmapScalingMode="NearestNeighbor"
               RenderOptions.EdgeMode="Aliased"
               SnapsToDevicePixels="True"
               RenderTransformOrigin="0.5,0.5">
            <Image.RenderTransform>
                <RotateTransform x:Name="SpinTransform" Angle="0"/>
            </Image.RenderTransform>
        </Image>
    </Canvas>
</Window>
