<Window x:Class="CharmDesk.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Height="620" Width="440" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen">
    <ScrollViewer Margin="20" VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="Settings" Style="{StaticResource H1}" Margin="0,0,0,16"/>

            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                <StackPanel>
                    <CheckBox x:Name="StartWithWindowsCheck" Content="Start with Windows" Margin="0,0,0,12" Checked="OnAnyChanged" Unchecked="OnAnyChanged"/>
                    <CheckBox x:Name="AlwaysOnTopCheck" Content="Always on top" Margin="0,0,0,12" Checked="OnAnyChanged" Unchecked="OnAnyChanged"/>
                    <CheckBox x:Name="SoundEffectsCheck" Content="Sound effects" Margin="0,0,0,12" Checked="OnAnyChanged" Unchecked="OnAnyChanged"/>
                    <CheckBox x:Name="Use24HourClockCheck" Content="24-hour clock (charms with a live time display)" Checked="OnAnyChanged" Unchecked="OnAnyChanged"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                <StackPanel>
                    <CheckBox x:Name="EnablePhysicsCheck" Content="Enable physics" Margin="0,0,0,14" Checked="OnAnyChanged" Unchecked="OnAnyChanged"/>

                    <Grid><TextBlock Text="Physics Intensity" Style="{StaticResource Label}" HorizontalAlignment="Left"/><TextBlock x:Name="IntensityValue" Style="{StaticResource Label}" HorizontalAlignment="Right"/></Grid>
                    <Slider x:Name="IntensitySlider" Minimum="0.2" Maximum="2.0" Margin="0,0,0,14" ValueChanged="OnSliderChanged"
                            AutomationProperties.Name="Physics intensity"/>

                    <Grid><TextBlock Text="Charm Scale" Style="{StaticResource Label}" HorizontalAlignment="Left"/><TextBlock x:Name="ScaleValue" Style="{StaticResource Label}" HorizontalAlignment="Right"/></Grid>
                    <Slider x:Name="ScaleSlider" Minimum="0.4" Maximum="2.5" ValueChanged="OnSliderChanged"
                            AutomationProperties.Name="Charm scale"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Default Charm" Style="{StaticResource Label}"/>
                    <ComboBox x:Name="DefaultCharmCombo" Margin="0,0,0,14" SelectionChanged="DefaultCharmCombo_SelectionChanged"
                              AutomationProperties.Name="Default charm">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBlock Text="Monitor" Style="{StaticResource Label}"/>
                    <ComboBox x:Name="MonitorCombo" SelectionChanged="MonitorCombo_SelectionChanged"
                              AutomationProperties.Name="Monitor">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Label}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Support CharmDesk" Style="{StaticResource Label}"/>
                    <TextBlock TextWrapping="Wrap" Margin="0,2,0,12" FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Text="CharmDesk is free, with no ads and nothing sent anywhere. If you're enjoying it, an optional tip helps keep it going - nothing changes either way."/>

                    <UniformGrid x:Name="NativeTipPanel" Columns="3" Margin="0,0,0,4">
                        <Button x:Name="TipSmallButton" Content="Small" Margin="0,0,6,0" Click="TipButton_Click"/>
                        <Button x:Name="TipMediumButton" Content="Medium" Margin="0,0,6,0" Click="TipButton_Click"/>
                        <Button x:Name="TipLargeButton" Content="Large" Click="TipButton_Click"/>
                    </UniformGrid>

                    <Button x:Name="ExternalTipButton" Content="Send a tip" Click="ExternalTipButton_Click" Visibility="Collapsed"/>

                    <TextBlock x:Name="TipStatusText" Style="{StaticResource Muted}" Margin="0,10,0,0" TextWrapping="Wrap" Text=" "/>
                </StackPanel>
            </Border>

            <Button Content="Reset Position" Margin="0,0,0,14" Click="ResetPositionButton_Click"/>

            <Button Content="Copy Diagnostic Info" Margin="0,0,0,4" Click="CopyDiagnosticsButton_Click"
                    ToolTip="Copies version info and the recent log to your clipboard - nothing is sent anywhere. Paste it when reporting an issue."/>
            <TextBlock x:Name="DiagnosticsStatusText" Style="{StaticResource Muted}" Margin="0,0,0,14" Text=" "/>

            <Button Content="Close" Style="{StaticResource AccentButton}" Click="CloseButton_Click"/>
        </StackPanel>
    </ScrollViewer>
</Window>
