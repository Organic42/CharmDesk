<Window x:Class="CharmDesk.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Height="620" Width="440" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen">
    <ScrollViewer Margin="20" VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="Settings" Style="{StaticResource H1}" Margin="0,0,0,16"/>

            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                <StackPanel>
                    <CheckBox x:Name="StartWithWindowsCheck" Content="Start with Windows" Margin="0,0,0,12" Checked="OnAnyChanged" Unchecked="OnAnyChanged"/>
                    <CheckBox x:Name="AlwaysOnTopCheck" Content="Always on top" Margin="0,0,0,12" Checked="OnAnyChanged" Unchecked="OnAnyChanged"/>
                    <CheckBox x:Name="SoundEffectsCheck" Content="Sound effects" Checked="OnAnyChanged" Unchecked="OnAnyChanged"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                <StackPanel>
                    <CheckBox x:Name="EnablePhysicsCheck" Content="Enable physics" Margin="0,0,0,14" Checked="OnAnyChanged" Unchecked="OnAnyChanged"/>

                    <Grid><TextBlock Text="Physics Intensity" Style="{StaticResource Label}" HorizontalAlignment="Left"/><TextBlock x:Name="IntensityValue" Style="{StaticResource Label}" HorizontalAlignment="Right"/></Grid>
                    <Slider x:Name="IntensitySlider" Minimum="0.2" Maximum="2.0" Margin="0,0,0,14" ValueChanged="OnSliderChanged"/>

                    <Grid><TextBlock Text="Charm Scale" Style="{StaticResource Label}" HorizontalAlignment="Left"/><TextBlock x:Name="ScaleValue" Style="{StaticResource Label}" HorizontalAlignment="Right"/></Grid>
                    <Slider x:Name="ScaleSlider" Minimum="0.4" Maximum="2.5" ValueChanged="OnSliderChanged"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Default Charm" Style="{StaticResource Label}"/>
                    <ComboBox x:Name="DefaultCharmCombo" Margin="0,0,0,14" DisplayMemberPath="Name" SelectionChanged="DefaultCharmCombo_SelectionChanged"/>

                    <TextBlock Text="Monitor" Style="{StaticResource Label}"/>
                    <ComboBox x:Name="MonitorCombo" DisplayMemberPath="Label" SelectionChanged="MonitorCombo_SelectionChanged"/>
                </StackPanel>
            </Border>

            <Button Content="Reset Position" Margin="0,0,0,14" Click="ResetPositionButton_Click"/>

            <Button Content="Close" Style="{StaticResource AccentButton}" Click="CloseButton_Click"/>
        </StackPanel>
    </ScrollViewer>
</Window>
