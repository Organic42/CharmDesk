<Window x:Class="CharmDesk.Windows.CharmManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Charm Manager" Height="640" Width="780" MinHeight="560" MinWidth="700"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="270"/>
            <ColumnDefinition Width="18"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left: preview -->
        <StackPanel Grid.Column="0">
            <TextBlock Text="Preview" Style="{StaticResource H1}" Margin="0,0,0,10"/>
            <Border Style="{StaticResource CardBorder}" Padding="0" ClipToBounds="True">
                <Canvas x:Name="PreviewCanvas" Width="266" Height="266" Background="#10121A">
                    <Path x:Name="PreviewString" Stroke="#B8B4AC" StrokeThickness="1.3"/>
                    <Ellipse x:Name="PreviewAnchor" Width="8" Height="8" Fill="#C4A044"/>
                    <Image x:Name="PreviewImage" Stretch="Fill"
                           RenderOptions.BitmapScalingMode="NearestNeighbor"
                           RenderTransformOrigin="0.5,0.5">
                        <Image.RenderTransform>
                            <RotateTransform x:Name="PreviewSpin" Angle="0"/>
                        </Image.RenderTransform>
                    </Image>
                </Canvas>
            </Border>
            <TextBlock Text="Drag the charm to test how it feels." Style="{StaticResource Muted}" Margin="0,8,0,0" TextWrapping="Wrap"/>

            <Button x:Name="PhysicsTestButton" Content="Physics Test" Margin="0,14,0,8" Click="PhysicsTestButton_Click"/>

            <Button x:Name="SelectPngButton" Content="Select PNG..." Margin="0,10,0,4" Click="SelectPngButton_Click"/>
            <TextBlock x:Name="PngPathText" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" Text="No file selected"/>

            <Button x:Name="SelectThumbButton" Content="Select Thumbnail..." Margin="0,10,0,4" Click="SelectThumbButton_Click"/>
            <TextBlock x:Name="ThumbPathText" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" Text="Optional - reuses main image"/>
        </StackPanel>

        <!-- Right: form -->
        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock x:Name="HeaderText" Text="Import Charm" Style="{StaticResource H1}" Margin="0,0,0,14"/>

                <TextBlock Text="Name" Style="{StaticResource Label}"/>
                <TextBox x:Name="NameBox" Margin="0,0,0,12" AutomationProperties.Name="Charm name"/>

                <TextBlock Text="Description" Style="{StaticResource Label}"/>
                <TextBox x:Name="DescriptionBox" Height="56" AcceptsReturn="True" TextWrapping="Wrap" Margin="0,0,0,12"
                         AutomationProperties.Name="Charm description"/>

                <TextBlock Text="Category" Style="{StaticResource Label}"/>
                <TextBox x:Name="CategoryBox" Margin="0,0,0,12" AutomationProperties.Name="Charm category"/>

                <CheckBox x:Name="EnabledCheck" Content="Enabled" IsChecked="True" Margin="0,0,0,16"/>

                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Display" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="Display Scale" Style="{StaticResource Label}" HorizontalAlignment="Left"/>
                            <TextBlock x:Name="DisplayScaleValue" Style="{StaticResource Label}" HorizontalAlignment="Right"/>
                        </Grid>
                        <Slider x:Name="DisplayScaleSlider" Minimum="0.3" Maximum="3.0" Value="1.0" ValueChanged="DisplayScaleSlider_ValueChanged" Margin="0,0,0,14"
                                AutomationProperties.Name="Display scale"/>

                        <TextBlock Text="Personality" Style="{StaticResource Label}"/>
                        <ComboBox x:Name="PersonalityCombo" DisplayMemberPath="Label" SelectionChanged="PersonalityCombo_SelectionChanged"
                                  AutomationProperties.Name="Personality"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="Physics" FontWeight="SemiBold" Margin="0,0,0,10"/>

                        <Grid><TextBlock Text="String Length" Style="{StaticResource Label}" HorizontalAlignment="Left"/><TextBlock x:Name="StringLengthValue" Style="{StaticResource Label}" HorizontalAlignment="Right"/></Grid>
                        <Slider x:Name="StringLengthSlider" Minimum="40" Maximum="280" Value="120" ValueChanged="PhysicsSlider_ValueChanged" Margin="0,0,0,10"
                                AutomationProperties.Name="String length"/>

                        <Grid><TextBlock Text="Gravity" Style="{StaticResource Label}" HorizontalAlignment="Left"/><TextBlock x:Name="GravityValue" Style="{StaticResource Label}" HorizontalAlignment="Right"/></Grid>
                        <Slider x:Name="GravitySlider" Minimum="200" Maximum="2000" Value="980" ValueChanged="PhysicsSlider_ValueChanged" Margin="0,0,0,10"
                                AutomationProperties.Name="Gravity"/>

                        <Grid><TextBlock Text="Damping" Style="{StaticResource Label}" HorizontalAlignment="Left"/><TextBlock x:Name="DampingValue" Style="{StaticResource Label}" HorizontalAlignment="Right"/></Grid>
                        <Slider x:Name="DampingSlider" Minimum="0.5" Maximum="0.99" Value="0.92" ValueChanged="PhysicsSlider_ValueChanged" Margin="0,0,0,10"
                                AutomationProperties.Name="Damping"/>

                        <Grid><TextBlock Text="Stiffness" Style="{StaticResource Label}" HorizontalAlignment="Left"/><TextBlock x:Name="StiffnessValue" Style="{StaticResource Label}" HorizontalAlignment="Right"/></Grid>
                        <Slider x:Name="StiffnessSlider" Minimum="0.02" Maximum="1.0" Value="0.15" ValueChanged="PhysicsSlider_ValueChanged" Margin="0,0,0,10"
                                AutomationProperties.Name="Stiffness"/>

                        <Grid><TextBlock Text="Mass" Style="{StaticResource Label}" HorizontalAlignment="Left"/><TextBlock x:Name="MassValue" Style="{StaticResource Label}" HorizontalAlignment="Right"/></Grid>
                        <Slider x:Name="MassSlider" Minimum="0.2" Maximum="5.0" Value="1.0" ValueChanged="PhysicsSlider_ValueChanged"
                                AutomationProperties.Name="Mass"/>
                    </StackPanel>
                </Border>

                <Grid Margin="0,18,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button x:Name="DeleteButton" Content="Delete" Style="{StaticResource DangerButton}" Click="DeleteButton_Click" Visibility="Collapsed"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel" Click="CancelButton_Click" Margin="0,0,8,0"/>
                        <Button Content="Save" Style="{StaticResource AccentButton}" Click="SaveButton_Click"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
